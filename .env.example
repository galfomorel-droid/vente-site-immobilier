# =====================================================================
# Variables d'environnement — à définir dans Railway (onglet "Variables")
# Copie ce fichier en ".env" pour un test local (optionnel).
# =====================================================================

# Adresse qui RECEVRA les messages du formulaire
CONTACT_TO=ton.adresse@gmail.com

# Adresse expéditrice (en général identique à SMTP_USER)
CONTACT_FROM=ton.adresse@gmail.com

# ---------------------------------------------------------------------
# OPTION 1 — Gmail (recommandé si tu utilises une adresse Gmail)
#   1. Active la validation en 2 étapes sur ton compte Google.
#   2. Crée un "mot de passe d'application" :
#      https://myaccount.google.com/apppasswords
#   3. Colle ce mot de passe (16 caractères) dans SMTP_PASS.
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ton.adresse@gmail.com
SMTP_PASS=mot_de_passe_application_google

# ---------------------------------------------------------------------
# OPTION 2 — Email du domaine via OVH (si tu préfères contact@creationsiteimmobilier.fr)
#   SMTP_HOST=ssl0.ovh.net
#   SMTP_PORT=465
#   SMTP_USER=contact@creationsiteimmobilier.fr
#   SMTP_PASS=mot_de_passe_de_la_boite
# ---------------------------------------------------------------------

# Railway fournit automatiquement PORT — ne pas le définir manuellement.
